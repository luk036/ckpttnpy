#! /usr/bin/env python3
import logging
import sys

from netlistx.netlist import Netlist, read_json

import _common

__author__ = "Wai-Shing Luk"
__copyright__ = "Wai-Shing Luk"
__license__ = "mit"

_logger = logging.getLogger(__name__)


class BiPartitionExperiment(_common.Experiment):
    description = "Multilevel Circuit Bi-Partitioning"
    k = 2

    def add_arguments(self, parser):
        parser.add_argument(
            dest="filename", help="file in json format", type=str, metavar="STR"
        )
        parser.add_argument(
            dest="bal_tol", help="ratio of balancing", type=float, metavar="FLOAT"
        )

    def check_args(self, args):
        if args.bal_tol >= 0.5:
            _logger.error("Balance ratio %s is too big", args.bal_tol)
            return False
        if args.bal_tol <= 0.3:
            _logger.warning("Balance ratio %s may be too small", args.bal_tol)
        return True

    def load(self, args) -> Netlist:
        return read_json(args.filename)


if __name__ == "__main__":
    BiPartitionExperiment().main(sys.argv[1:])
