#! /usr/bin/env python3
import logging
import sys

from netlistx.netlist import Netlist, create_random_hgraph

import _common

__author__ = "Wai-Shing Luk"
__copyright__ = "Wai-Shing Luk"
__license__ = "mit"

_logger = logging.getLogger(__name__)


class RandomPartExperiment(_common.Experiment):
    description = "Multilevel Circuit Partition demonstration"
    k = 2

    def add_arguments(self, parser):
        parser.add_argument(
            dest="N", help="number of modules", type=int, metavar="INT"
        )
        parser.add_argument(dest="M", help="number of nets", type=int, metavar="INT")
        parser.add_argument(
            dest="eta", help="ratio of nets and pins", type=float, metavar="FLOAT"
        )

    def check_args(self, args):
        if args.eta >= 1:
            _logger.error("eta value %s is too big", args.eta)
            return False
        if args.eta > 0.3:
            _logger.warning("eta value %s may be too big", args.eta)
        return True

    def load(self, args) -> Netlist:
        return create_random_hgraph(args.N, args.M, args.eta)

    def get_bal_tol(self, args) -> float:
        return 0.45


if __name__ == "__main__":
    RandomPartExperiment().main(sys.argv[1:])
